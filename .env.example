# --- Entorno ---
# "production" apaga /docs, /redoc y /openapi.json, y baja el log a INFO.
# ⚠️ Si NO se define, vale "development" y la documentación queda PÚBLICA.
#    En el servidor de producción esto TIENE que estar en production.
ENV=development

# --- DB ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=cmc_local
MYSQL_USER=cmc
MYSQL_PASS=cmc

# --- CORS ---
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# --- JWT / Cookies ---
JWT_SECRET=dev-secret-change-me
JWT_ALG=HS256
ACCESS_MINUTES=60
REFRESH_DAYS=15
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# --- Front ---
FRONT_BASE_URL=http://localhost:5173
ALLOWED_FRONT_HOSTS=http://localhost:5173,http://127.0.0.1:5173

# --- Legacy SSO (optional) ---
LEGACY_BASE_URL=
LEGACY_SSO_SECRET=

# --- Cron (auto-cierre período médico) ---
CRON_SECRET=change-me-generate-a-random-secret

# --- RBAC ---
# false = modo observación: si al usuario le falta el permiso que declara
#         app/auth/authz.py, se registra un WARNING y la request pasa igual.
# true  = rechazo real con 403.
# Arranca en false a propósito: cerrar 301 endpoints de golpe rompe pantallas
# del front sin aviso. Ver docs/api/RBAC_PROPUESTA.md §7.
RBAC_ENFORCE=false

# --- Rate limiting de autenticación ---
# Cuenta solo intentos FALLIDOS de login / cambio de contraseña, en ventana
# deslizante. Por IP es tolerante (un consultorio comparte salida NAT);
# por cuenta es estricto, que es lo que corta el password spraying.
# Ver app/core/ratelimit.py.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_PER_IP=20
RATE_LIMIT_MAX_PER_SOCIO=8

# --- Uploads ---
# Tamaño máximo por archivo, en bytes. 20 MB.
MAX_UPLOAD_BYTES=20971520

# --- Demo seed ---
SEED_ADMIN_NRO_SOCIO=9999
SEED_ADMIN_MATRICULA=1234
SEED_ADMIN_PASSWORD=admin123
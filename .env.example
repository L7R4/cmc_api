# --- Entorno ---
# "production" apaga /docs, /redoc y /openapi.json, y baja el log a INFO.
# ⚠️ Si NO se define, vale "development" y la documentación queda PÚBLICA.
#    En el servidor de producción esto TIENE que estar en production.
ENV=development

# --- DB ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=cmc_local
MYSQL_USER=cmc
MYSQL_PASS=cmc

# --- CORS ---
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# --- JWT / Cookies ---
JWT_SECRET=dev-secret-change-me
JWT_ALG=HS256
ACCESS_MINUTES=60
REFRESH_DAYS=15
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# --- Front ---
FRONT_BASE_URL=http://localhost:5173
ALLOWED_FRONT_HOSTS=http://localhost:5173,http://127.0.0.1:5173

# --- Legacy SSO (optional) ---
LEGACY_BASE_URL=
LEGACY_SSO_SECRET=

# --- Cron (auto-cierre período médico) ---
CRON_SECRET=change-me-generate-a-random-secret

# --- Integradores con obras sociales (Sancor, Nobis, OSPJN) ---
# Los tres *_MODO son OBLIGATORIOS — sin default en config.py: si falta
# cualquiera de las tres líneas, la API no arranca. "simulado" = no sale ningún
# request real. "test"/"produccion" generan autorizaciones/órdenes reales y
# piden URL + credenciales del modo correspondiente (si faltan, tampoco
# arranca) — ver docs/api/validaciones/sancor.md.

# Sancor Salud (O.S. 411) — HL7 v2.4 sobre SOAP.
SANCOR_MODO=simulado
SANCOR_URL_TEST=https://testservicios.sancorsalud.com.ar/Autorizador/WSDL/HL7v24
SANCOR_URL_PROD=https://servicios.sancorsalud.com.ar/Autorizador/HL7v24
SANCOR_CUIT=30573190692
SANCOR_PRESTADOR=46632
SANCOR_PASAPORTE_TEST=
SANCOR_PASAPORTE_PROD=

# Nobis Salud (O.S. 402) — WSGeCROS (SOAP 1.2).
NOBIS_MODO=simulado
NOBIS_URL_TEST=https://wstest.nobissalud.com:7004/WSGecrosNet.asmx
NOBIS_URL_PROD=https://servicioweb.nobissalud.com.ar/WSGecrosNet.asmx
NOBIS_USUARIO=
NOBIS_CLAVE=

# OSPJN · Poder Judicial (O.S. 151) — REST.
OSPJN_MODO=simulado
OSPJN_URL_TEST=https://api-test.ospjn.gov.ar/ospjn.prestadores.api/PrestadorService.svc/rest
OSPJN_URL_PROD=https://api.ospjn.gov.ar/ospjn.prestadores.api/PrestadorService.svc/rest
OSPJN_USUARIO=
OSPJN_PASSWORD=

# --- RBAC ---
# false = modo observación: si al usuario le falta el permiso que declara
#         app/auth/authz.py, se registra un WARNING y la request pasa igual.
# true  = rechazo real con 403.
# Arranca en false a propósito: cerrar 301 endpoints de golpe rompe pantallas
# del front sin aviso. Ver docs/api/RBAC_PROPUESTA.md §7.
RBAC_ENFORCE=false

# --- Facturación: carga sin precio ---
# false = default: un código sin precio vigente (para esa OS/fecha/perfil del
#         médico) rechaza la carga con 422.
# true  = permite cargar la prestación igual, con honorarios/gastos/ayudante en
#         0. NO afecta habilitación del médico, fecha inválida ni vía no
#         aplicable — eso sigue rechazando igual. Pensado solo para pruebas.
CARGA_SIN_PRECIO=false

# --- Rate limiting de autenticación ---
# Cuenta solo intentos FALLIDOS de login / cambio de contraseña, en ventana
# deslizante. Por IP es tolerante (un consultorio comparte salida NAT);
# por cuenta es estricto, que es lo que corta el password spraying.
# Ver app/core/ratelimit.py.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_PER_IP=20
RATE_LIMIT_MAX_PER_SOCIO=8

# --- Uploads ---
# Tamaño máximo por archivo, en bytes. 20 MB.
MAX_UPLOAD_BYTES=20971520

# --- Demo seed ---
SEED_ADMIN_NRO_SOCIO=9999
SEED_ADMIN_MATRICULA=1234
SEED_ADMIN_PASSWORD=admin123